LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Optional separate provider connections for /model switching:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_API_KEY=

# Optional TOML file for context limits and compaction preferences:
# DAPHNIS_CONFIG=daphnis.toml

# Optional verified local tokenizer for deepseek-v4-pro:
# DEEPSEEK_V4_PRO_TOKENIZER=/absolute/path/to/tokenizer.json

# Experimental session retrieval. Unset to keep history_search.
# DAPHNIS_RETRIEVAL=bm25
# For semantic or hybrid, explicitly configure a trusted embeddings endpoint:
# DAPHNIS_EMBEDDING_URL=http://127.0.0.1:8766/embeddings
# DAPHNIS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# DAPHNIS_EMBEDDING_DIMENSIONS=384
# DAPHNIS_EMBEDDING_API_KEY=
