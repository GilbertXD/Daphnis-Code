LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Optional separate provider connections for switching models:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_API_KEY=

# Optional TOML file for context limits and compaction preferences:
# DAPHNIS_CONFIG=daphnis.toml

# Optional one-time import from a legacy MCP configuration:
# DAPHNIS_MCP_CONFIG=./legacy-mcp.json

# Optional verified local tokenizer for deepseek-v4-pro:
# DEEPSEEK_V4_PRO_TOKENIZER=/absolute/path/to/tokenizer.json

# Optional OpenAI-compatible / Ollama embedding service for hybrid long-term memory RAG:
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=qwen3-embedding:8b
# EMBEDDING_API_KEY=
